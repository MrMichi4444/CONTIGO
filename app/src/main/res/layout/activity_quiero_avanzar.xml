<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MICRO-ACCIONES DIARIAS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingTop="16dp"/>

    <!-- Acción principal (será aleatoria) -->
    <TextView
        android:id="@+id/tvMainAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acción principal aquí"
        android:textSize="18sp"
        android:textStyle="italic"
        android:layout_marginTop="24dp"/>

    <!-- Acciones extra (aleatorias también) -->
    <TextView
        android:id="@+id/tvExtra1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acción extra 1"
        android:textSize="16sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvExtra2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acción extra 2"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
